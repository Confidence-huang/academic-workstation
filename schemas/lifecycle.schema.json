{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/academic-workstation/lifecycle.schema.json",
  "title": "Skill lifecycle evidence",
  "type": "object",
  "required": ["schemaVersion", "stages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "PASS_WITH_WARNING", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]},
          "details": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
