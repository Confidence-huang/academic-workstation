{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/academic-workstation/acceptance-matrix.schema.json",
  "title": "Academic Workstation acceptance matrix",
  "type": "object",
  "required": ["schemaVersion", "overallStatus", "gates", "rows", "coverage"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "generatedAt": {"type": "string", "minLength": 1},
    "overallStatus": {"enum": ["PASS", "PASS_WITH_WARNING", "FAIL", "BLOCKED", "UNAVAILABLE"]},
    "gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/row"}},
    "coverage": {
      "type": "object",
      "required": ["supported", "tested", "unavailable", "ignoredEvidenceRecords"],
      "properties": {
        "supported": {"type": "integer", "minimum": 0},
        "tested": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0},
        "ignoredEvidenceRecords": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PASS", "PASS_WITH_WARNING", "FAIL", "BLOCKED", "NOT_RUN", "UNAVAILABLE"]},
        "sourceRevision": {"type": "string"},
        "fileCount": {"type": "integer", "minimum": 0},
        "checks": {"type": "array"},
        "backupComparison": {"type": "object"},
        "restoreComparison": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["artifact", "artifactType", "supportStatus", "testStatus", "status", "gates"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "artifactType": {"enum": ["pptx", "docx", "xlsx", "vsdx", "latex", "pdf"]},
        "supportStatus": {"enum": ["SUPPORTED", "EXPERIMENTAL", "UNAVAILABLE"]},
        "testStatus": {"enum": ["TESTED", "UNAVAILABLE"]},
        "nativeApplication": {"type": "string"},
        "highestLevel": {"type": "string"},
        "status": {"enum": ["PASS", "PASS_WITH_WARNING", "FAIL", "BLOCKED", "UNAVAILABLE"]},
        "gates": {"type": "object", "additionalProperties": {"type": "string"}},
        "evidenceRecords": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
