{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/academic-workstation/status.schema.json",
  "title": "Derived evidence status",
  "type": "object",
  "required": ["status", "warningCount", "deferredCount", "blockerCount", "reasons"],
  "properties": {
    "status": {"enum": ["PASS", "PASS_WITH_WARNING", "FAIL", "BLOCKED"]},
    "warningCount": {"type": "integer", "minimum": 0},
    "deferredCount": {"type": "integer", "minimum": 0},
    "blockerCount": {"type": "integer", "minimum": 0},
    "failedRequiredCheckCount": {"type": "integer", "minimum": 0},
    "requiredNotRunCount": {"type": "integer", "minimum": 0},
    "notRunCount": {"type": "integer", "minimum": 0},
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
